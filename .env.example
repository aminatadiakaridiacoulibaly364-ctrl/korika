# Base de données
# En local : SQLite. En production avec Supabase : collez la chaîne Postgres de votre projet.
DATABASE_URL="file:./dev.db"
# OU : postgresql://postgres:VOTRE_MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres

# JWT de session (admin + clients). Mettez une longue chaîne aléatoire.
JWT_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"

# Email administrateur (compte admin unique) et mot de passe initial (hashé au seed)
ADMIN_EMAIL="votre-email@exemple.com"
ADMIN_PASSWORD="ChoisissezUnMotDePasseFort123"

# WhatsApp par défaut (modifiable ensuite depuis /admin -> Paramètres)
WHATSAPP_NUMBER="2250700000000"

# Nom de la boutique
STORE_NAME="KORIKA FASHION"
